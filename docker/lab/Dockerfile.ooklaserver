FROM ubuntu:22.04

# Populated by buildx / docker compose automatically. Defaults to amd64 for
# plain `docker build` invocations.
ARG TARGETARCH=amd64

RUN apt-get update \
 && apt-get install -y --no-install-recommends wget ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ookla

# The upstream OoklaServer.tgz is a bundle of per-platform archives, so the static-musl Linux
# build for this architecture has to be picked out of it.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) inner="OoklaServer-linux-x86_64-static-musl.tgz" ;; \
      arm64) inner="OoklaServer-linux-aarch64-static-musl.tgz" ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    wget -q https://install.speedtest.net/ooklaserver/stable/OoklaServer.tgz -O outer.tgz; \
    tar -xzf outer.tgz "./${inner}"; \
    tar -xzf "./${inner}"; \
    rm -f outer.tgz "./${inner}"; \
    cp OoklaServer.properties.default OoklaServer.properties; \
    chmod +x OoklaServer

COPY lab-properties.sh ./

# Turns off the server's own outbound traffic, which would cross a shaped link mid-measurement.
# Build-time, so a setting the upstream file no longer names fails the build.
RUN bash lab-properties.sh OoklaServer.properties

EXPOSE 8080/tcp 8080/udp

# Loopback deliberately: shaping is on the link container's eth0, so this stays fast on every
# profile and reports on OoklaServer rather than the link.
#
# Nothing gates on it. start.sh's own poll and status sweep decide whether the lab came up.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q --spider http://localhost:8080/speedtest/latency.txt || exit 1

# No entry point of its own, and no NET_ADMIN granted to this container: the shaping is the link
# container's job, and OoklaServer runs here as the upstream binary with nothing wrapped round it.
CMD ["./OoklaServer"]
