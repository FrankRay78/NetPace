FROM ubuntu:22.04

# iproute2 supplies tc and ip, which shape.sh uses to apply a slow-link profile to this
# container's own interface. This is the only image in the lab that carries them: the servers
# join this container's network namespace and shape nothing themselves. Present whether or not a
# profile is requested, so a profile is never refused for want of a tool the image could have
# carried.
RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/lab

COPY link-profiles.sh shape.sh ./

# shape.sh writes this file once the link is in the state that was asked for — both directions
# shaped and read back, or deliberately unshaped when no profile was requested — and deletes it
# on the way in, so it is never left over from an earlier run. Each server declares this container
# healthy as its start condition, which is what keeps a server from accepting its first
# connection on a link that is not shaped yet.
HEALTHCHECK --interval=1s --timeout=3s --start-period=2s --retries=60 \
  CMD test -f /run/netpace-lab/shaped

# Invoked through bash rather than directly, so the entry point does not depend on the
# executable bit surviving the checkout the image is built from. No CMD: shape.sh holds the
# network namespace open itself rather than handing over to a server.
ENTRYPOINT ["bash", "/opt/lab/shape.sh"]
