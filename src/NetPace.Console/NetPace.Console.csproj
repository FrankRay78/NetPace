<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>netpace</AssemblyName>
    <!-- Pinned because all three otherwise default to AssemblyName, which would put the lowercase
         command name in the Windows version resource where users read the product name. -->
    <AssemblyTitle>NetPace</AssemblyTitle>
    <Product>NetPace</Product>
    <Company>NetPace</Company>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Embed portable PDBs inside the assembly so non-AOT release archives ship no side .pdb files. -->
    <DebugType>embedded</DebugType>
    <!-- Prevent NetPace.Core.xml from landing in publish output — PublishSingleFile bundles the DLL but not XML,
         so without this the documentation file appears as a stray second entry in every release archive. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- .NET tool package. `dotnet tool install -g NetPace` is the one-line install for anyone with the
       .NET 10 SDK; docs/RELEASING.md records which package each release pushes and where it is built. -->
  <PropertyGroup Label="Tool package">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>NetPace</PackageId>
    <ToolCommandName>netpace</ToolCommandName>
    <!-- One RID-specific tool package per platform NetPace covers, plus a wrapper package that points
         the installer at the right one. Declared as RuntimeIdentifiers rather than
         ToolPackageRuntimeIdentifiers because restore reads this property: the per-RID packs need
         RID-specific assets, and ToolPackageRuntimeIdentifiers alone leaves restore RID-agnostic. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <Title>NetPace</Title>
    <Description>Cross-platform network speed testing CLI. Measures latency, download and upload speed against Ookla Speedtest servers, with human-readable, CSV and JSON output.</Description>
    <Authors>Frank Ray</Authors>
    <Copyright>Frank Ray</Copyright>
    <PackageTags>speedtest;internet-speed-test;network-speed-test;cli;dotnet-tool;console</PackageTags>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FrankRay78/NetPace</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/FrankRay78/NetPace</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>https://github.com/FrankRay78/NetPace/releases</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <WarningsAsErrors>IL2026;IL2090;IL3050;IL3056</WarningsAsErrors>
    <!-- The AOT toolchain writes native symbols beside the binary (netpace.dbg on Linux,
         netpace.pdb on Windows, a netpace.dSYM folder on macOS) and copies them into the publish
         directory after Publish has run, where no publish-output filter can reach them. They are
         roughly twice the size of the binary and ship to nobody, so they would otherwise make every
         RID-specific tool package about two and a half times its packed size. The release workflow asserts each native package holds the binary and its
         settings file and nothing else, so one slipping through fails the release rather than shipping. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ByteSize" Version="2.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Spectre.Console" Version="0.57.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetPace.Core\NetPace.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="slant.flf" />
	<InternalsVisibleTo Include="NetPace.Console.Tests" />
  </ItemGroup>

  <!-- The tool package's nuget.org page and icon. Packed as README.md so nuget.org renders it. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\resources\nuget\README.tool.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\resources\nuget\logo.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- Remove XML documentation files from publish output: PublishSingleFile bundles DLLs but not XML files,
       so NetPace.Core.xml would land loose in every archive and break the "exactly 1 entry" contract. -->
  <Target Name="ExcludeDocXmlFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
