# The chain runner: one firing of gaffer's chain/chain-next.sh against NetPace's settings file.
# Started by netpace-chain-next.timer.
#
# One-time setup on the build machine: clone gaffer for the runner alone
# (`git clone https://github.com/FrankRay78/gaffer-claude.git ~/Repos/gaffer-runner`), clone this
# repository as a full clone marked `git config chain-next.dedicated true` at ~/Repos/NetPace-runner
# with a git identity, and copy both unit files to ~/.config/systemd/user/. Then edit the
# machine-specific values to match the machine: the two clone paths below (in ExecStartPre and
# ExecStart) and PATH here, and "clone" in .gaffer/chain.json, which is the directory the runner
# checks, resets and builds in. User units start with a minimal environment, so PATH must name
# where claude, dotnet, gh, jq, git, flock and timeout live. The settings file is read from the
# runner's clone, so that clone must already hold it: on first install, `git -C
# ~/Repos/NetPace-runner fetch origin && git -C ~/Repos/NetPace-runner checkout -f -B main
# origin/main` before the first firing.

[Unit]
Description=NetPace chain runner: build the next ready issue to a pull request

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.dotnet:%h/.dotnet/tools:/usr/local/bin:/usr/bin:/bin
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# The runner's clone of gaffer, brought to gaffer's main before each firing, under the runner's
# own lock so a run started by hand is never updated beneath (a held lock fails this step, and
# with it the firing, which is right: a run is in progress). The runner itself never updates the
# clone, and refuses to run from it when it is not plainly main (another branch, local edits or
# commits), so a failure here stops the firing before anything is selected.
ExecStartPre=/bin/mkdir -p %h/.local/state/gaffer-chain/NetPace-runner
ExecStartPre=/usr/bin/flock -n %h/.local/state/gaffer-chain/NetPace-runner/lock /usr/bin/git -C %h/Repos/gaffer-runner pull -q --ff-only
# gaffer's runner, handed NetPace's settings from the runner's clone of this repository: the clone
# to reset, the writers whose issues it may build, each stage's model and effort, and the
# permissions opt-in (.gaffer/chain.json).
ExecStart=/bin/bash %h/Repos/gaffer-runner/chain/chain-next.sh %h/Repos/NetPace-runner/.gaffer/chain.json
# A chain run takes the better part of an hour, and the chain bounds each stage itself.
TimeoutStartSec=infinity
