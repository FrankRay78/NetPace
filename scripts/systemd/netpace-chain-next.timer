# Fires netpace-chain-next.service every 15 minutes. A firing while a run is in progress does
# nothing: systemd does not start an active service twice, and the script also holds a lock.

[Unit]
Description=NetPace chain runner: check for a ready issue every 15 minutes

[Timer]
OnCalendar=*:0/15
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
